# Data — ~1 GB tf.data snapshot of hand photographs, not distributed.
# A 24-image sample lives in data/samples/ and IS committed.
data/processed/
data/**/*.jpg
data/**/*.jpeg

# Large model checkpoints. The scratch models (~3 MB) are committed; the
# transfer backbones are not — they exceed GitHub's file limits and the
# harness refetches ImageNet weights automatically.
models/mobilenetv2.keras
models/inceptionresnetv2.keras
models/*transfer*
*.h5

# Training logs
experiments/run.log

